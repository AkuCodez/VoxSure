# Copy to .env (never commit .env). All values are optional; defaults work locally.

# Whisper model: small (default, multilingual) | base (faster, multilingual, less accurate) | base.en (English only!)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Database. Default is a local SQLite file. For managed PostgreSQL use e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./voxsure.db

# Comma-separated origins allowed to call the API when the frontend is hosted
# separately (e.g. on Vercel). Leave empty for single-origin deployment.
CORS_ORIGINS=

# Limits
MAX_AUDIO_BYTES=5242880
ASR_TIMEOUT_S=45

# ---- Open-domain "general" answers (optional) ----
# Without a key, non-campus questions get the standard "outside what I can help with" reply.
# Option 1: Claude (paid, per-use billing and rate limits). Set the key in your own environment, never in code or chat:
# ANTHROPIC_API_KEY=
# GENERAL_MODEL=claude-opus-5-5          # or claude-haiku-5-5 for cheaper/faster
#
# Option 2: any OpenAI-compatible provider. Several offer free tiers with their own rate limits (check current terms):
# GENERAL_PROVIDER=openai_compat
# GENERAL_API_KEY=
# GENERAL_BASE_URL=https://api.groq.com/openai/v1                       # Groq
#   or https://generativelanguage.googleapis.com/v1beta/openai/          # Google Gemini (OpenAI-compatible endpoint)
#   or https://openrouter.ai/api/v1                                      # OpenRouter (some models are free)
# GENERAL_MODEL=<model id from that provider's current model list>
# GENERAL_PROVIDER_NAME=Groq                                             # shown to users on AI-generated answers
#
# Safety valves
# GENERAL_DAILY_CAP=300                  # max general answers per day across all users
# GENERAL_ANSWERS_ENABLED=true           # set false to disable the feature entirely
